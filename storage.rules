rules_version = '2';

// Firebase Storage security rules for Ensemble.
//
// Same situation as firestore.rules: not wired to a Firebase CLI project in
// this repo, so paste this into Firebase Console → Storage → Rules → Publish.
// Firebase Storage ships with its own separate default rule that also
// expires ~30 days after project creation and then denies everything —
// worth checking if uploads start failing with "permission denied" later.
service firebase.storage {
  match /b/{bucket}/o {

    // profile-photos/{uid}.jpg — a user's own profile photo. Reads are
    // public (no request.auth check) because <Image> loads it as a plain
    // https:// URL with no Firebase auth attached, and it's already shared
    // with connections via the profile snapshot anyway. Only the owner can
    // write their own file.
    match /profile-photos/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // chat-media/{chatId}/{fileName} — images/video/voice notes sent in a
    // chat. chatId is "<uidA>_<uidB>" sorted, so, same as Firestore's chat
    // rules, membership is derived from the path itself with no lookup.
    match /chat-media/{chatId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid in chatId.split('_');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
