rules_version = '2';

// Firestore security rules for inStereo.
//
// This file isn't wired up to a Firebase CLI project in this repo (no
// firebase.json/.firebaserc), so it isn't auto-deployed — copy it into
// Firebase Console → Firestore Database → Rules and Publish, or set up
// `firebase deploy --only firestore:rules` once this repo is linked to a
// Firebase project.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — a user's own profile. Nothing else ever needs to read
    // another user's profile doc directly: invites embed a `creatorProfile`
    // snapshot, and connections embed a `profiles` map for both
    // participants (kept in sync by updateUserProfile), so this is
    // strictly self-only.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // invites/{id} — publicly readable so an unauthenticated recipient can
    // see who invited them before signing in (see invite/[id].tsx). Only
    // the creator can create one; any signed-in user can accept one
    // (mark it used) via acceptInvite().
    match /invites/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if request.auth != null
        && resource.data.status == "pending"
        && request.resource.data.usedByUid == request.auth.uid;
      allow delete: if false;
    }

    // connections/{id} — visible only to its two participants. `read` covers
    // both get() and the array-contains(users, uid) query in
    // watchConnectionsWithProfiles(); Firestore filters list results to the
    // documents that satisfy this per-document check.
    match /connections/{id} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users;
      allow delete: if false;
    }

    // chats/{chatId}/messages/{messageId} — chatId is "<uidA>_<uidB>" sorted,
    // so membership is derived from the ID itself with no lookup needed.
    // Only the two participants can read the thread or send into it; a
    // message can only ever be edited/deleted by whoever sent it.
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid in chatId.split('_');
      allow create: if request.auth != null
        && request.auth.uid in chatId.split('_')
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid in chatId.split('_')
        && resource.data.senderId == request.auth.uid;
    }
  }
}
