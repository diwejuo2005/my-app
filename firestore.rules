rules_version = '2';

// Firestore security rules for Ensemble.
//
// This file isn't wired up to a Firebase CLI project in this repo (no
// firebase.json/.firebaserc), so it isn't auto-deployed — copy it into
// Firebase Console → Firestore Database → Rules and Publish, or set up
// `firebase deploy --only firestore:rules` once this repo is linked to a
// Firebase project.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — a user's own profile.
    // `get` (single-doc read by known uid) is allowed for any signed-in
    // user, since watchConnectionsWithProfiles() reads a connection
    // partner's profile by uid. `list` (querying the whole collection) is
    // deliberately not allowed, so profiles can't be enumerated — you can
    // only read one if you already know its uid.
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // invites/{id} — publicly readable so an unauthenticated recipient can
    // see who invited them before signing in (see invite/[id].tsx). Only
    // the creator can create one; any signed-in user can accept one
    // (mark it used) via acceptInvite().
    match /invites/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if request.auth != null
        && resource.data.status == "pending"
        && request.resource.data.usedByUid == request.auth.uid;
      allow delete: if false;
    }

    // connections/{id} — visible only to its two participants. `read` covers
    // both get() and the array-contains(users, uid) query in
    // watchConnectionsWithProfiles(); Firestore filters list results to the
    // documents that satisfy this per-document check.
    match /connections/{id} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users;
      allow delete: if false;
    }
  }
}
