rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    // Any signed-in user can read any profile (needed to show connection details)
    // Only you can write your own profile
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Invites
    // Any signed-in user can read (needed to display the invite before accepting)
    // Only the creator can create their own invite
    // Any signed-in user can update a pending invite (to mark it as used when accepting)
    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.creatorUid == request.auth.uid
        || resource.data.status == 'pending'
      );
    }

    // Connections
    // Only users who are part of the connection can read or write it
    match /connections/{connectionId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users;
    }

    // Chats
    // Only the two participants can read/write messages
    // chatId format: uid1_uid2 (sorted alphabetically)
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderUid == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.senderUid == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.senderUid == request.auth.uid;
      }
    }

    // Pulse data
    // Only you can write your own pulse entries
    // Any authenticated user can read (connections see your mood)
    match /pulseData/{uid}/entries/{entryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Schedule data
    // Only you can write your own events
    // Any authenticated user can read (connections see your schedule)
    match /scheduleData/{uid}/events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
