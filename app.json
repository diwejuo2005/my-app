{
  "expo": {
    "name": "inStereo",
    "slug": "instereo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "instereo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.instereo",
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.instereo",
      "adaptiveIcon": {
        "backgroundColor": "#07080f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "inStereo shows your upcoming events so the people you're connected to can see when you're free.",
          "remindersPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "inStereo lets you choose photos and videos to share with the people you're connected to.",
          "cameraPermission": false,
          "microphonePermission": "inStereo uses your microphone to record voice notes and video sound for your connections."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "inStereo uses your microphone to record voice notes for your connections."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d76f0998-653d-40d7-86e2-273a293e1a5e"
      }
    },
    "owner": "diwejuo"
  }
}
